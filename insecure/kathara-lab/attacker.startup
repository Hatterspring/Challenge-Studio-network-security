#!/bin/bash
# Attacker workstation. Populates it with the standard OSS toolset used to
# work through all three chains. Requires the Kathara host to have build-time
# internet egress; if not, pre-bake an image instead.
apt-get update -qq
apt-get install -y --no-install-recommends \
    nmap netcat-openbsd python3 python3-pip openssh-client \
    socat smbclient ldap-utils sshpass rdesktop freerdp2-x11 \
    curl iproute2 tcpdump vim >/dev/null

pip3 install --no-cache-dir --break-system-packages \
    impacket netexec >/dev/null 2>&1 || \
    pip3 install --no-cache-dir impacket netexec >/dev/null

ip link set eth1 down
ip addr add 10.0.0.10/24 dev eth0 2>/dev/null || true

ip route add default via 10.0.0.1

echo "[attacker] ready: nmap, netcat, impacket, netexec, socat, smbclient, rdesktop"
