#!/bin/bash
# Attacker workstation. 
apt-get update -qq
apt-get install -y --no-install-recommends \
    nmap netcat-openbsd python3 python3-pip openssh-client \
    socat smbclient ldap-utils sshpass samba samba-dsdb-modules hashcat clinfo >/dev/null 

#added modules: samba, samba-dsdb-modules, hashcat, clinfo

ip addr add 172.16.0.10/24 dev eth0

ip route add default via 172.16.0.1 #added routing, directly to the vulnerable network in this case
