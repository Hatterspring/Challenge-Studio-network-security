#!/bin/bash

#This is an edge to the (poorly configured)DMZ of OT Solutions' network. As vpn bypasses the dmz, 
#the dmz is not included in this project.
ip addr add 10.0.0.10/24 dev eth0 # dmz
ip addr add 10.10.10.254/24 dev eth1  # it_lan

echo 1 > /proc/sys/net/ipv4/ip_forward


#added some routing solutions
ip route add default via 10.0.0.1 dev eth0

ip route add 10.20.0.0/16 via 10.10.10.253 dev eth1