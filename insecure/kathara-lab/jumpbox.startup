#!/bin/bash
apt-get update -qq
apt-get install -y --no-install-recommends openssh-server socat iproute2 >/dev/null

ip link set eth2 down

ip addr add 10.20.20.5/24 dev eth0 2>/dev/null # ot_dmz-facing
ip addr add 10.30.30.5/24 dev eth1 2>/dev/null # ot_lan-facing
echo 1 > /proc/sys/net/ipv4/ip_forward

#added logs as a secondary method of reconnaissance
mkdir /var/log/ot_logs
echo "7/10/2026 13:44:02 | connect | data: {port: 44818, user: root, pass: embedded123} 
7/10/2026 13:56 | disconnect | data: {user: root, actions: [GET_PROJECT, LIST_TAGS, QUIT]}" > /var/log/ot_logs/rockwell_log.log
echo "5/10/2026 11:51:47 | connect | data: {port: 20256, user: root} 
5/10/2026 12:32 | disconnect | data: {user: root, actions: [LOGIN, ..., QUIT]}" > /var/log/ot_logs/unitronics_log.log

#added routing
ip route add default via 10.20.20.254

useradd -m -s /bin/bash otadmin 
echo "otadmin:Ch@ngeMe2026" | chpasswd

mkdir -p /run/sshd
/usr/sbin/sshd

nohup socat TCP-LISTEN:8888,fork TCP:10.30.30.20:80 > /var/log/socat.log 2>&1 &