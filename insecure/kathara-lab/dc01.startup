#!/bin/bash
# Minimal Samba4 Active Directory Domain Controller.
# Deliberately weak: the domain has a service account whose password matches
# the one leaked from edge-fw's backup config (T1552 -> credential reuse into
# a Domain Admin-equivalent account). This lets students demonstrate
# NTDS.dit-style secrets dumping (T1003.003) with e.g. impacket secretsdump.

apt-get update -qq
apt-get install -y --no-install-recommends samba krb5-user winbind smbclient samba-ad-provision samba-vfs-modules samba-dsdb-modules libpam-winbind libnss-winbind pamtester >/dev/null 
#added modules: samba-dsdb-modules libpam-winbind libnss-winbind pamtester

echo "nameserver 10.10.10.10" > /etc/resolv.conf # so that setup using internet can be completed but samba recognises this domain


ip addr add 10.10.10.10/24 dev eth0 2>/dev/null
hostname dc01

rm /etc/samba/smb.conf # added

if [ ! -f /var/lib/samba/private/sam.ldb ]; then
    samba-tool domain provision \
        --realm=CORP.LOCAL \
        --domain=CORP \
        --server-role=dc \
        --dns-backend=SAMBA_INTERNAL \
        --adminpass='Summer2026!' \
        --use-rfc2307

    #added the ability for dc01 to recognise samba users as physical users on the system. svc_backup is given root privileges, a huge vulnerability.

    samba-tool user create --uid-number=0 --gid-number=0 svc_backup 'Summer2026!'
    samba-tool group addmembers "Domain Admins" svc_backup

    samba-tool user create ot_admin 'Ch@ngeMe2026' # added ot credentials
    samba-tool group add "Operational Technology"
    samba-tool group addmembers "Operational Technology" ot_admin
fi

pam-auth-update # added to ensure that Debian users can be created from Samba users

cat sample_smb_conf.txt > /etc/samba/smb.conf # added as smb.conf does not specify template shell and homedir by default.


#added home directory for svc_backup
mkdir /home/svc_backup
chown svc_backup /home/svc_backup
chmod 700 /home/svc_backup

nohup samba -i /var/log/samba.log 2>&1 &

printf '%s\n' 'PermitRootLogin yes' > /etc/ssh/sshd_config.d/99-root-login.conf # added to allow lateral movement to svc_backup

service ssh start
