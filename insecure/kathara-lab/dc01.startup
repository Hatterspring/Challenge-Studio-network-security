#!/bin/bash
# Minimal Samba4 Active Directory Domain Controller.
# Deliberately weak: the domain has a service account whose password matches
# the one leaked from edge-fw's backup config (T1552 -> credential reuse into
# a Domain Admin-equivalent account). This lets students demonstrate
# NTDS.dit-style secrets dumping (T1003.003) with e.g. impacket secretsdump.

apt-get update -qq
apt-get install -y --no-install-recommends samba krb5-user winbind smbclient >/dev/null

ip link set eth1 down

ip addr add 10.10.10.10/24 dev eth0 2>/dev/null || true
hostname dc01

if [ ! -f /var/lib/samba/private/sam.ldb ]; then
    samba-tool domain provision \
        --realm=CORP.LOCAL \
        --domain=CORP \
        --server-role=dc \
        --dns-backend=SAMBA_INTERNAL \
        --adminpass='Summer2026!' \
        --use-rfc2307

    samba-tool user create svc_backup 'Summer2026!' || true
    samba-tool group addmembers "Domain Admins" svc_backup || true
fi

nohup samba -i --no-process-group -s /usr/local/samba/etc/smb.conf \
    > /var/log/samba.log 2>&1 &

echo "[dc01] CORP.LOCAL DC up. Weak/reused cred: svc_backup / Summer2026! (Domain Admin)."
