#!/bin/bash
apt-get update -qq
apt-get install -y --no-install-recommends python3 iproute2 >/dev/null

ip addr add 172.16.0.1/24 dev eth0 2>/dev/null # internet-facing
ip addr add 10.0.0.1/24 dev eth1 # dmz-facing

ip route add 10.10.10.0/24 via 10.0.0.10 dev eth1 #route into the it dmz edge

#add logs that expose vpn password
mkdir /var/log/vpn_logs 
echo "8/10/2026 13:44:22 | connect | data: {user: corpadmin, pass: admin123} 
8/10/2026 13:56:51 | disconnect | data: {user: corpadmin}" > /var/log/vpn_logs/access_log.log

echo 1 > /proc/sys/net/ipv4/ip_forward

nohup python3 /appliance.py > /var/log/appliance.log 2>&1 &
