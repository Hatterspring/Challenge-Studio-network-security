#!/bin/bash

apt-get update -qq
apt-get install -y --no-install-recommends xrdp openssh-client sshpass smbclient >/dev/null

ip link set eth1 down

ip addr add 10.10.10.30/24 dev eth0 2>/dev/null || true

ip route add default via 10.10.10.254 # added routing

useradd -m -s /bin/bash corpadmin 2>/dev/null
echo "corpadmin:admin123" | chpasswd

# removed saved OT admin credentials here as they are reflected in the password on Domain Controller.

chown -R corpadmin:corpadmin /home/corpadmin

#Volt Typhoon uses lateral movement techniques such as RDP; since RDP is not possible on Kathara, SSH is used instead.
#service xrdp start 2>/dev/null || xrdp 
service ssh start 

mkdir -p /run/sshd
/usr/sbin/sshd